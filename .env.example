# Copy to .env.local and fill in. Never commit real keys.
LLM_PROVIDER=anthropic          # anthropic | gemini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL_FAST=               # optional cheaper model for the analyze step
GEMINI_API_KEY=
# gemini-3.5-flash-lite was fast (7-9 s a run) and passed validation on every test run; gemini-2.5-flash is the fallback.
GEMINI_MODEL=gemini-3.5-flash-lite
